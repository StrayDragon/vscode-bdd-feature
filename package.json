{
  "name": "vscode-bdd-feature",
  "displayName": "BDD Feature",
  "description": "Enhanced pytest-bdd .feature file support with Chinese/English Gherkin highlighting, step navigation, and test integration",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "gherkin",
    "bdd",
    "pytest-bdd",
    "feature",
    "cucumber",
    "chinese",
    "中文"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:feature",
    "onLanguage:python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "feature",
        "aliases": [
          "Gherkin",
          "feature",
          "BDD Feature"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "feature",
        "scopeName": "source.feature",
        "path": "./syntaxes/feature.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "feature",
        "scopes": {
          "gherkin-table-header": ["markup.bold.gherkin-table-header"]
        }
      }
    ],
    "commands": [
      {
        "command": "bddFeature.createStep",
        "title": "BDD: Create Step Definition",
        "category": "BDD",
        "icon": "$(add)"
      },
      {
        "command": "bddFeature.runScenario",
        "title": "BDD: Run Scenario",
        "category": "BDD",
        "icon": "$(play)"
      },
      {
        "command": "bddFeature.debugScenario",
        "title": "BDD: Debug Scenario",
        "category": "BDD",
        "icon": "$(debug)"
      },
      {
        "command": "bddFeature.runFile",
        "title": "BDD: Run File",
        "category": "BDD",
        "icon": "$(play-all)"
      },
      {
        "command": "bddFeature.debugFile",
        "title": "BDD: Debug File",
        "category": "BDD",
        "icon": "$(debug-all)"
      },
      {
        "command": "bddFeature.refreshSteps",
        "title": "BDD: Refresh Step Definitions",
        "category": "BDD",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "bddFeature.runScenario",
        "key": "ctrl+shift+r",
        "when": "editorLangId == feature"
      },
      {
        "command": "bddFeature.debugScenario",
        "key": "ctrl+shift+t",
        "when": "editorLangId == feature"
      },
      {
        "command": "bddFeature.createStep",
        "key": "ctrl+shift+c",
        "when": "editorLangId == feature"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bddFeature.createStep",
          "when": "editorLangId == feature",
          "group": "bdd@1"
        },
        {
          "command": "bddFeature.runScenario",
          "when": "editorLangId == feature",
          "group": "bdd@2"
        },
        {
          "command": "bddFeature.debugScenario",
          "when": "editorLangId == feature",
          "group": "bdd@3"
        },
        {
          "command": "bddFeature.runFile",
          "when": "editorLangId == feature",
          "group": "bdd@4"
        },
        {
          "command": "bddFeature.debugFile",
          "when": "editorLangId == feature",
          "group": "bdd@5"
        }
      ],
      "commandPalette": [
        {
          "command": "bddFeature.createStep",
          "when": "editorLangId == feature"
        },
        {
          "command": "bddFeature.runScenario",
          "when": "editorLangId == feature"
        },
        {
          "command": "bddFeature.debugScenario",
          "when": "editorLangId == feature"
        },
        {
          "command": "bddFeature.runFile",
          "when": "editorLangId == feature || editorLangId == python"
        },
        {
          "command": "bddFeature.debugFile",
          "when": "editorLangId == feature || editorLangId == python"
        }
      ]
    },
    "configuration": {
      "title": "BDD Feature",
      "properties": {
        "bddFeature.parser": {
          "type": "string",
          "default": "string",
          "enum": ["string", "parse", "cfparse", "re"],
          "enumDescriptions": [
            "Exact string matching (default)",
            "Python format-string style: {param:type}",
            "Cardinality field parser: {param:Type+}",
            "Regular expression matching"
          ],
          "description": "Step definition parser type for generating step stubs"
        },
        "bddFeature.pytestCommand": {
          "type": "string",
          "default": "pytest -q",
          "description": "Pytest command used for running tests"
        },
        "bddFeature.pytestDebugArgs": {
          "type": "array",
          "default": [],
          "description": "Extra arguments passed to pytest when debugging"
        }
      }
    },
    "semanticTokenColorCustomizations": {
      "[feature]": {
        "enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1"
  }
}
