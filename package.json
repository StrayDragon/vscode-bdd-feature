{
  "name": "vscode-bdd-feature",
  "displayName": "BDD Feature",
  "description": "Enhanced pytest-bdd .feature file support with Chinese/English Gherkin highlighting, step navigation, and test integration",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StrayDragon/vscode-bdd-feature.git"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "gherkin",
    "bdd",
    "pytest-bdd",
    "feature",
    "cucumber",
    "chinese",
    "中文"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:feature",
    "onLanguage:python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "feature",
        "aliases": [
          "Gherkin",
          "feature",
          "BDD Feature"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "feature",
        "scopeName": "source.feature",
        "path": "./syntaxes/feature.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "feature",
        "scopes": {
          "gherkin-table-header": ["markup.bold.gherkin-table-header"]
        }
      }
    ],
    "commands": [
      {
        "command": "bddFeature.createStep",
        "title": "BDD: Create Step Definition",
        "category": "BDD",
        "icon": "$(add)"
      },
      {
        "command": "bddFeature.runScenario",
        "title": "BDD: Run Scenario",
        "category": "BDD",
        "icon": "$(play)"
      },
      {
        "command": "bddFeature.debugScenario",
        "title": "BDD: Debug Scenario",
        "category": "BDD",
        "icon": "$(debug)"
      },
      {
        "command": "bddFeature.runFile",
        "title": "BDD: Run File",
        "category": "BDD",
        "icon": "$(play-all)"
      },
      {
        "command": "bddFeature.debugFile",
        "title": "BDD: Debug File",
        "category": "BDD",
        "icon": "$(debug-all)"
      },
      {
        "command": "bddFeature.refreshSteps",
        "title": "BDD: Refresh Step Definitions",
        "category": "BDD",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "bddFeature.runScenario",
        "key": "ctrl+shift+r",
        "when": "editorLangId == feature"
      },
      {
        "command": "bddFeature.debugScenario",
        "key": "ctrl+shift+t",
        "when": "editorLangId == feature"
      },
      {
        "command": "bddFeature.createStep",
        "key": "ctrl+shift+c",
        "when": "editorLangId == feature"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bddFeature.createStep",
          "when": "editorLangId == feature",
          "group": "bdd@1"
        },
        {
          "command": "bddFeature.runScenario",
          "when": "editorLangId == feature",
          "group": "bdd@2"
        },
        {
          "command": "bddFeature.debugScenario",
          "when": "editorLangId == feature",
          "group": "bdd@3"
        },
        {
          "command": "bddFeature.runFile",
          "when": "editorLangId == feature",
          "group": "bdd@4"
        },
        {
          "command": "bddFeature.debugFile",
          "when": "editorLangId == feature",
          "group": "bdd@5"
        }
      ],
      "commandPalette": [
        {
          "command": "bddFeature.createStep",
          "when": "editorLangId == feature"
        },
        {
          "command": "bddFeature.runScenario",
          "when": "editorLangId == feature"
        },
        {
          "command": "bddFeature.debugScenario",
          "when": "editorLangId == feature"
        },
        {
          "command": "bddFeature.runFile",
          "when": "editorLangId == feature || editorLangId == python"
        },
        {
          "command": "bddFeature.debugFile",
          "when": "editorLangId == feature || editorLangId == python"
        }
      ]
    },
    "configuration": {
      "title": "BDD Feature",
      "properties": {
        "bddFeature.parser": {
          "type": "string",
          "default": "parse",
          "enum": ["string", "parse", "cfparse", "re"],
          "enumDescriptions": [
            "Exact string matching (default)",
            "Python format-string style: {param:type}",
            "Cardinality field parser: {param:Type+}",
            "Regular expression matching"
          ],
          "description": "Step definition parser type for generating Python step stubs"
        },
        "bddFeature.pytestCommand": {
          "type": "string",
          "default": "pytest -q",
          "description": "Pytest command used for running tests"
        },
        "bddFeature.pytestDebugArgs": {
          "type": "array",
          "default": [],
          "description": "Extra arguments passed to pytest when debugging"
        },
        "bddFeature.cargoTestCommand": {
          "type": "string",
          "default": "cargo test",
          "description": "Cargo command used for running rstest-bdd scenarios"
        },
        "bddFeature.featuresBaseDir": {
          "type": "string",
          "default": null,
          "description": "Base directory for .feature paths in scenarios() calls (mirrors pytest-bdd's bdd_features_base_dir ini). Defaults to each binding file's directory."
        },
        "bddFeature.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Report problems for .feature and step-definition files"
        },
        "bddFeature.diagnostics.undefinedSteps": {
          "type": "boolean",
          "default": true,
          "description": "Warn about steps without any matching definition"
        },
        "bddFeature.diagnostics.duplicateDefinitions": {
          "type": "boolean",
          "default": true,
          "description": "Info-mark step definitions whose text duplicates another"
        },
        "bddFeature.diagnostics.unusedDefinitions": {
          "type": "boolean",
          "default": false,
          "description": "Hint step definitions never referenced by any feature"
        },
        "bddFeature.diagnostics.unboundFeatures": {
          "type": "boolean",
          "default": false,
          "description": "Warn when a feature file has no scenarios()/#[scenario] binding"
        },
        "bddFeature.enableCodeActions": {
          "type": "boolean",
          "default": true,
          "description": "Offer quick fixes (create missing step, bind feature)"
        },
        "bddFeature.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show runnable lenses above scenarios and usage counts above definitions"
        },
        "bddFeature.codeLens.runScenarios": {
          "type": "boolean",
          "default": true,
          "description": "Run/Debug lenses above scenario headers"
        },
        "bddFeature.codeLens.usages": {
          "type": "boolean",
          "default": true,
          "description": "Reference-count lenses above step definitions (Python/Rust)"
        },
        "bddFeature.enableDocumentSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Provide Outline/Breadcrumbs structure for .feature files"
        },
        "bddFeature.enableWorkspaceSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Index scenarios and step definitions for Ctrl+P # search"
        },
        "bddFeature.enableFoldingRanges": {
          "type": "boolean",
          "default": true,
          "description": "Allow folding scenarios/rules/docstrings in .feature files"
        },
        "bddFeature.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Hover cards for steps (definition preview) and scenarios (run command)"
        },
        "bddFeature.enableTableFormatting": {
          "type": "boolean",
          "default": true,
          "description": "Align Gherkin table pipes via Format Document/Selection (CJK-width aware)"
        },
        "bddFeature.enableRename": {
          "type": "boolean",
          "default": true,
          "description": "Rename exact-match steps across definitions and features; sync Rust scenario names"
        },
        "bddFeature.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Gherkin skeleton snippets (scenario/outline/background/rule)"
        }
      }
    },
    "semanticTokenColorCustomizations": {
      "[feature]": {
        "enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "update-gherkin-languages": "node scripts/update-gherkin-languages.mjs && node scripts/generate-grammar.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1"
  }
}
